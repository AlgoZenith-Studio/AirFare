# AeroFareX collector environment configuration

# Firebase Storage (raw payload archive)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=aerofarex-raw-observations
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

# Database (writes fare_observations / fare_components)
DATABASE_URL=postgresql://aerofarex:<pw>@localhost:5432/aerofarex

# Collection schedule & rate limiting
COLLECTION_SLOTS=02:30,05:30,13:00,19:00
DEFAULT_RATE_LIMIT_SECONDS=3.5
MAX_RETRIES=4
CIRCUIT_FAILURE_THRESHOLD=10
USER_AGENT=AeroFareX-StatisticalCollector/2.0 (+https://mospi.gov.in/aerofarex-collector)
